# Copy to .env and fill in. .env is git-ignored: never commit real values.
# PayPal Developer dashboard > Apps & Credentials > Sandbox > Default Application
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI provider key: chosen together with the project concept

# Vercel AI Gateway key (not needed on Vercel: OIDC)
AI_GATEWAY_API_KEY=

# Hosted state store (Supabase). Without these, a local JSON file is used.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_STATE_SECRET=
# Vercel Blob (photos), set automatically when the Blob store is connected
BLOB_READ_WRITE_TOKEN=
PAYPAL_WEBHOOK_ID=
ADMIN_TOKEN=
# Optional: Google Gemini key (used first when set)
GEMINI_API_KEY=
