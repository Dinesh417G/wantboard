# Copy to .env and fill in. .env is git-ignored: never commit real values.
# PayPal Developer dashboard > Apps & Credentials > Sandbox > Default Application
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI provider key: chosen together with the project concept

# Vercel AI Gateway key (not needed on Vercel: OIDC)
AI_GATEWAY_API_KEY=
